{
    "name": "my-inventory-app",
    "private": true,
    "scripts": {
        "prepare": "cd .. && husky meteor-app/.husky",
        "check:ci": "npm ci && meteor lint && npm run check:type && npm run check:code-style",
        "check:ci:fresh": "npm run clean:generated && npm run check:ci",
        "check:code-style": "npm run check:code-style:prettier && npm run check:code-style:lint",
        "check:code-style:lint": "eslint .",
        "check:code-style:prettier": "prettier --check .",
        "check:type": "tsc --version && tsc --noEmit",
        "clean:generated": "node ../scripts/cleanup-meteor-generated.mjs --app-dir .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "start:nasdb:run": "export MONGO_URL=\"${NAS_MONGO_URL}\" && npm start",
        "start:nasdb": "dotenv -e ../.env npm run start:nasdb:run",
        "start": "meteor run",
        "test": "meteor test --once --driver-package meteortesting:mocha",
        "test-app": "TEST_WATCH=1 meteor test --full-app --driver-package meteortesting:mocha",
        "test:e2e": "cd .. && npm run test:e2e",
        "test:e2e:ui": "cd .. && npm run test:e2e:ui",
        "test:e2e:headed": "cd .. && npm run test:e2e:headed",
        "test:e2e:debug": "cd .. && npm run test:e2e:debug",
        "test:e2e:skip-server": "cd .. && npm run test:e2e:skip-server",
        "test:e2e:skip-server:ui": "cd .. && npm run test:e2e:skip-server:ui",
        "test:e2e:skip-server:headed": "cd .. && npm run test:e2e:skip-server:headed",
        "test:e2e:skip-server:debug": "cd .. && npm run test:e2e:skip-server:debug",
        "visualize": "meteor --production --extra-packages bundle-visualizer",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build -o ../storybook-static"
    },
    "dependencies": {
        "@babel/core": "^7.28.4",
        "@babel/runtime": "^7.28.4",
        "@types/papaparse": "^5.5.2",
        "archiver": "^7.0.1",
        "grommet": "^2.50.0",
        "grommet-icons": "^4.14.0",
        "lodash": "^4.17.21",
        "meteor-node-stubs": "^1.2.24",
        "mime-types": "^2.1.35",
        "papaparse": "^5.5.3",
        "polished": "^4.3.1",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "sharp": "^0.33.5",
        "styled-components": "^5.3.11",
        "unzipper": "^0.12.3",
        "wouter": "^3.8.0"
    },
    "devDependencies": {
        "@storybook/addon-docs": "^10.0.0",
        "@storybook/addon-onboarding": "^10.0.0",
        "@storybook/addon-webpack5-compiler-swc": "^4.0.1",
        "@storybook/react-webpack5": "^10.4.1",
        "@types/archiver": "^6.0.2",
        "@types/chai": "^5.2.2",
        "@types/lodash": "^4.17.20",
        "@types/meteor": "^2.9.9",
        "@types/mime-types": "^2.1.4",
        "@types/mocha": "^10.0.10",
        "@types/mongodb": "^4.0.6",
        "@types/node": "^24.5.2",
        "@types/react": "^18.3.24",
        "@types/react-dom": "^18.3.7",
        "@types/sinon": "^17.0.4",
        "@types/styled-components": "^5.1.34",
        "@typescript-eslint/eslint-plugin": "^8.44.0",
        "@typescript-eslint/parser": "^8.44.0",
        "@xch/prettier-config": "^0.1.1",
        "babel-plugin-styled-components": "^2.1.4",
        "chai": "^6.0.1",
        "dotenv-cli": "^7.4.4",
        "eslint": "^8.57.1",
        "eslint-config-love": "^84.1.1",
        "eslint-config-prettier": "^8.10.2",
        "eslint-import-resolver-meteor": "^0.4.0",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-meteor": "^7.3.0",
        "eslint-plugin-n": "^17.23.0",
        "eslint-plugin-promise": "^7.2.1",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-storybook": "^10.0.0",
        "globals": "^16.4.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.2.6",
        "prettier": "2.8.8",
        "sinon": "^21.0.0",
        "storybook": "^10.0.0",
        "typescript": "^5.9.2"
    },
    "engines": {
        "node": "22.x || 24.x",
        "npm": ">=10.0.0"
    },
    "prettier": "@xch/prettier-config",
    "lint-staged": {
        "*.{ts,tsx,js,jsx,json,css,md}": "prettier --write"
    },
    "meteor": {
        "mainModule": {
            "client": "client/main.tsx",
            "server": "server/main.ts"
        }
    }
}
